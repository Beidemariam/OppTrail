DATABASE_URL=sqlite:////data/app.db
FRONTEND_STATIC_DIR=/app/frontend-out
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Applied to the OpenAI client so a hung or flaky call fails the request
# instead of hanging it; retries use the SDK's own backoff. A reasoning model
# needs tens of seconds before it has thought about anything, so a timeout
# below ~60 fails every call rather than the slow ones (D-168).
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
# minimal | low | medium | high, or empty to send no reasoning parameter at
# all - which is what a non-reasoning OPENAI_MODEL needs, since the Responses
# API rejects the parameter outright for those. Left unset on a reasoning
# model, the default effort spends thousands of reasoning tokens summarizing a
# short timeline.
OPENAI_REASONING_EFFORT=low
# development | production | test. Production turns on Secure cookies and hides
# exception text from error responses.
ENVIRONMENT=production
# Login and signup are rate limited per source address, counted separately.
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Ceiling for a stored upload, in bytes (10 MiB). No endpoint accepts a file yet.
MAX_UPLOAD_BYTES=10485760
# ADR 0003's live-update stream. The server closes each SSE connection after
# SSE_MAX_CONNECTION_SECONDS and the browser's EventSource reconnects, so an
# intermediary never reaps a connection this app still believes in; the
# heartbeat is the comment line that keeps an idle stream from looking dead,
# and it is also the reconnect delay advertised to the client.
SSE_MAX_CONNECTION_SECONDS=300
SSE_HEARTBEAT_SECONDS=15
# `make backup`'s VACUUM INTO snapshots (ADR 0011). Unset defaults to a
# "backups" directory next to the database file, which for the shipped
# DATABASE_URL above is /data/backups -- inside the same mounted volume.
BACKUP_DIR=
BACKUP_RETENTION_COUNT=7
