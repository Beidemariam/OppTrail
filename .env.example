DATABASE_URL=sqlite:////data/app.db
FRONTEND_STATIC_DIR=/app/frontend-out

# Who may define a custom field or write an automation rule (R.1c, D-215).
# Comma-separated email addresses; empty means nobody, which is the safe
# default and the loud one -- the screens say who to ask rather than failing a
# form. These are the two widest write surfaces in the app and both are global
# rather than scoped to a deal, so there is no opportunity owner to fall back
# on. Set this or those two features are unavailable to everyone.
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Applied to the OpenAI client so a hung or flaky call fails the request
# instead of hanging it; retries use the SDK's own backoff. A reasoning model
# needs tens of seconds before it has thought about anything, so a timeout
# below ~60 fails every call rather than the slow ones (D-168). Measured
# against gpt-5-nano; a different OPENAI_MODEL may need a different ceiling.
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
# minimal | low | medium | high, or empty to send no reasoning parameter at
# all - which is what a non-reasoning OPENAI_MODEL needs, since the Responses
# API rejects the parameter outright for those. Left unset on a reasoning
# model, the default effort spends thousands of reasoning tokens summarizing a
# short timeline.
OPENAI_REASONING_EFFORT=low
# development | production | test. Production turns on Secure cookies and hides
# exception text from error responses.
ENVIRONMENT=production
# Login and signup are rate limited per source address, counted separately.
AUTH_RATE_LIMIT_ATTEMPTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Ceiling for a stored upload, in bytes (10 MiB), enforced by
# `uploads.validate_upload` on every attachment POST.
MAX_UPLOAD_BYTES=10485760

# `None`/empty means "next to the database file", which for the DATABASE_URL
# above is /data/attachments -- ADR 0008's blobs on the same volume as the
# database they belong to, so a container recreate needs no second mount.
ATTACHMENTS_DIR=
# ADR 0003's live-update stream. The server closes each SSE connection after
# SSE_MAX_CONNECTION_SECONDS and the browser's EventSource reconnects, so an
# intermediary never reaps a connection this app still believes in; the
# heartbeat is the comment line that keeps an idle stream from looking dead,
# and it is also the reconnect delay advertised to the client.
SSE_MAX_CONNECTION_SECONDS=300
SSE_HEARTBEAT_SECONDS=15
# `make backup`'s VACUUM INTO snapshots (ADR 0011). Unset defaults to a
# "backups" directory next to the database file, which for the shipped
# DATABASE_URL above is /data/backups -- inside the same mounted volume.
BACKUP_DIR=
BACKUP_RETENTION_COUNT=7

# ADR 0004's in-process scheduler (milestone 6.5): no broker and no worker
# container, which assumes exactly one instance -- two would double-run every
# periodic job, since nothing here claims a lock.
SCHEDULER_ENABLED=true
# How often the two time-driven automation triggers are evaluated
# (`no_activity`, `close_date_approaching`). Fifteen minutes rather than one
# because both are measured in days: a rule about fourteen days of silence
# does not become wrong fourteen minutes late.
AUTOMATION_INTERVAL_MINUTES=15
# How often the snapshot above is taken unattended. Daily, which is what
# BACKUP_RETENTION_COUNT=7 already assumed when it kept a week.
BACKUP_INTERVAL_HOURS=24
# The forecast's stage ramp (`docs/FEATURES.md` §10). A JSON object of stage
# name to a number between 0 and 1; any stage left out keeps the built-in
# default, so a deployment can tune two stages without restating the other
# five. Left commented out rather than set empty on purpose: the value is
# parsed as JSON, and an empty string is not valid JSON, so
# `FORECAST_PROBABILITIES=` fails startup with a SettingsError.
# FORECAST_PROBABILITIES={"Qualification": 0.2, "Negotiation": 0.75}
