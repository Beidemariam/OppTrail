.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
.venv/

# Node/Next.js
node_modules/
.next/
out/
tsconfig.tsbuildinfo

# The container's bind-mounted volume (`./data` -> `/data`): the database, its
# backups, and ADR 0008's attachment blobs. The blobs are content-addressed and
# carry no extension, so no pattern below matches them -- milestone 4.3 is what
# made this directory something other than one ignored `.db` file.
data/
# The throwaway volume behind the Phase R gate checks (R.1c): a second
# instance on :8001 holding the demo seed plus the confirmed-scale corpus, so
# the review's performance and restore checks run against 805,000 rows
# without touching the real one. Deleted when the round is done.
data-demo/

# Local data and logs
*.db
# WAL puts the journal and shared-memory files alongside the database.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
.coverage
.pytest_cache/

# Test output: Vitest coverage, Playwright artefacts, and the throwaway
# database scripts/e2e-server.sh rebuilds on every run.
coverage/
coverage.xml
playwright-report/
test-results/
.e2e/

# OS/editor
.DS_Store
